FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY services /app/services
COPY stand /app/stand
COPY policies /app/policies
COPY scenarios/development /app/scenarios/development
RUN pip install --no-cache-dir '.[api,distributed]' && useradd --create-home --uid 10001 appuser
USER 10001
EXPOSE 8000
CMD ["uvicorn","services.demo_api:app","--host","0.0.0.0","--port","8000"]
