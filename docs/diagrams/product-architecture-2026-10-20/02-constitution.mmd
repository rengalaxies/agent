flowchart TD
  B["Доверенная настройка: principal, scope, права и лимиты"] --> L["Список разрешенных источников и версий"]
  L --> C["Сбор снимков с происхождением и временем"]
  C --> X["Парсеры плюс LLM для текстовых кандидатов"]
  X --> V["Проверка структуры, ссылок и области"]
  V --> F["Наблюдаемые факты"]
  V --> R["Кандидаты правил и требований"]
  R --> D["Дедупликация, проверка применимости и конфликтов"]
  D --> A{"Есть действующее доверенное подтверждение?"}
  A -->|"да"| K["Применимый набор правил"]
  A -->|"нет или конфликт"| Q["Адресный вопрос владельцу"]
  Q --> U{"Ответ уполномоченного владельца"}
  U -->|"подтверждено"| K
  U -->|"отклонено или неизвестно"| Z["Кандидаты, отказы и пробелы"]
  Q -->|"ответа пока нет"| Z
  F --> M["Версионный пакет: правила, факты, кандидаты и пробелы"]
  K --> M
  Z --> M
  D -->|"черновик доступен сразу"| M
  M --> P["Контекст для планирования задачи"]
