flowchart TD
  S["Разрешенные код, документы, политики и конфигурации"] --> K["Версионная конституция и индекс зависимостей"]
  H["Разработчик или внешний coding agent"] --> Q["Запрос до кода или diff после изменения"]
  K --> A["Анализ влияния в доступной области"]
  Q --> A
  A --> R["Факты, риски, неизвестное и проверки"]
  R --> H
  R --> N["Черновик адресного уведомления"]
  N --> P{"Отправка разрешена?"}
  P -->|"да"| D["Доставка и учет результата"]
  P -->|"нет"| C["Оставить черновик"]
  D --> O["Ответ владельца или отчет проверки"]
  O --> K
  H --> T["Обычный процесс разработки и выпуска команды"]
  T --> U["Новый код или конфигурация"]
  U --> K
