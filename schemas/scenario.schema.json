{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datamesh-release-protocol:scenario:0.3.0",
  "title": "Canonical metadata change scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "family_id",
    "split",
    "description",
    "old_contract",
    "new_contract",
    "obligations",
    "migrations"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[MUTILP]-[0-9]{2}$"},
    "family_id": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]},
    "split": {"enum": ["development", "evaluation"]},
    "description": {"type": "string", "minLength": 1},
    "old_contract": {"$ref": "#/$defs/contract"},
    "new_contract": {"$ref": "#/$defs/contract"},
    "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "migrations": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning", "formula", "identity_scope", "allowed_sources", "purposes"],
      "properties": {
        "meaning": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "formula": {"type": "string"},
        "unit": {"type": ["string", "null"]},
        "scale": {"type": ["integer", "null"]},
        "calculation_window_days": {"type": ["integer", "null"], "minimum": 1},
        "identity_scope": {"type": "string"},
        "allowed_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "valid_time": {"type": "string"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "contract_version", "owner_domain", "schema_fields", "semantic"],
      "properties": {
        "product_id": {"type": "string"},
        "contract_version": {"type": "string"},
        "owner_domain": {"type": "string"},
        "schema_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "semantic": {"$ref": "#/$defs/semantic"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "obligation_version", "consumer_id", "consumer_domain", "product_id"],
      "properties": {
        "obligation_id": {"type": "string"},
        "obligation_version": {"type": "string"},
        "consumer_id": {"type": "string"},
        "consumer_domain": {"type": "string"},
        "product_id": {"type": "string"},
        "required_meaning": {"type": ["string", "null"]},
        "required_formula": {"type": ["string", "null"]},
        "accepted_units": {"type": "array", "items": {"type": "string"}},
        "accepted_scales": {"type": "array", "items": {"type": "integer"}},
        "min_window_days": {"type": ["integer", "null"], "minimum": 1},
        "accepted_identity_scopes": {"type": "array", "items": {"type": "string"}},
        "allowed_sources": {"type": "array", "items": {"type": "string"}},
        "required_purposes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
