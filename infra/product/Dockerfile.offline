FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY wheelhouse /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels 'datamesh-release-protocol[api]' && rm -rf /wheels && useradd --uid 10001 --create-home product
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["python", "-m", "change_completion.web_server"]
